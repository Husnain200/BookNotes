
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookNotes</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <h1>My BookNotes Library</h1>

    <!-- Success and error messages -->

    <% if (message === "duplicate") { %>
        <p class="notice" role="status">
            This book is already in your library!
        </p>
    <% } %>

    <% if (message === "invalid_date") { %>
        <p class="notice" role="alert">
            Please enter a valid reading date.
        </p>
    <% } %>

    <% if (message === "future_date") { %>
        <p class="notice" role="alert">
            Reading date cannot be in the future.
        </p>
    <% } %>

    <% if (message === "old_date") { %>
        <p class="notice" role="alert">
            Reading date cannot be before 1 January 1900.
        </p>
    <% } %>

    <% if (message === "invalid_rating") { %>
        <p class="notice" role="alert">
            Rating must be between 1 and 5.
        </p>
    <% } %>


    <!-- Search books -->

    <form action="/search" method="GET">
        <input
            type="text"
            name="q"
            placeholder="Search for a book..."
            required
        >

        <button type="submit">Search Books</button>
    </form>


    <!-- Sort books -->

    <form action="/" method="GET">

        <label for="sort">Sort Books By:</label>

        <select name="sort" id="sort">

            <option value="recent"
                <%= selectedSort === "recent" ? "selected" : "" %>>
                Recently Read
            </option>

            <option value="rating"
                <%= selectedSort === "rating" ? "selected" : "" %>>
                Highest Rating
            </option>

            <option value="title"
                <%= selectedSort === "title" ? "selected" : "" %>>
                Title (A-Z)
            </option>

        </select>

        <button type="submit">Sort</button>

    </form>


    <!-- Display books -->

    <% if (books.length > 0) { %>

        <% books.forEach(book => { %>

            <div class="book">

                <% if (book.cover_id) { %>
                    <img
                        src="https://covers.openlibrary.org/b/id/<%= book.cover_id %>-M.jpg"
                        alt="<%= book.title %> cover"
                        width="150"
                    >
                <% } %>

                <h2><%= book.title %></h2>

                <p>Author: <%= book.author || "Unknown" %></p>

                <!-- Update book details -->

                <form action="/books/<%= book.id %>/update" method="POST">

                    <label>My Rating:</label>

                    <select name="rating">

                        <option value=""
                            <%= book.rating == null ? "selected" : "" %>>
                            Not rated
                        </option>

                        <% [1, 2, 3, 4, 5].forEach(number => { %>
                            <option
                                value="<%= number %>"
                                <%= book.rating == number ? "selected" : "" %>
                            >
                                <%= number %> Stars
                            </option>
                        <% }); %>

                    </select>

                    <br><br>

                    <label>My Personal Notes:</label>

                    <br>

                    <textarea
                        name="notes"
                        rows="5"
                        cols="40"
                        placeholder="Write your thoughts about this book..."
                    ><%= book.notes || "" %></textarea>

                    <br><br>

                    <label>Date Read:</label>

                    <input
                        type="date"
                        name="date_read"
                        value="<%= book.date_read_input || '' %>"
                    >

                    <br><br>

                    <button type="submit">Save Changes</button>

                </form>


                <!-- Delete book -->

                <form
                    action="/books/<%= book.id %>/delete"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this book?')"
                >
                    <button type="submit">Delete Book</button>
                </form>

            </div>

            <hr>

        <% }); %>

    <% } else { %>

        <p>No books found. Add your first book!</p>

    <% } %>

    <script src="/js/main.js"></script>

</body>
</html>
