
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Search Results - BookNotes</title>

    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="search-page">

    <!-- Search Page Header -->
    <header class="search-header">

        <h1>Discover Books</h1>

        <p>Find your next read and add it to your personal library.</p>

        <!-- Search Form -->
        <form action="/search" method="GET">

            <input
                type="text"
                name="q"
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                placeholder="Search for a book..."
                required
            >

            <button type="submit">Search</button>

        </form>

        <a href="/">← Back to My Library</a>

    </header>


    <!-- Search Results -->
    <main>

        <h2>
            Results for "<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
        </h2>


        <!-- API Error Handling -->
        <% if (typeof error !== "undefined" && error) { %>

            <p class="notice" role="alert">
                <%= error %>
            </p>


        <!-- Display Books -->
        <% } else if (Array.isArray(books) && books.length > 0) { %>

            <div class="search-results">

                <% books.forEach(book => { %>

                    <article class="search-book">

                        <!-- Book Cover -->
                        <div class="search-book-cover">

                            <% if (book.cover_i) { %>

                                <img
                                    src="https://covers.openlibrary.org/b/id/<%= book.cover_i %>-M.jpg"
                                    alt="<%= book.title %> cover"
                                    loading="lazy"
                                >

                            <% } else { %>

                                <div class="no-cover">
                                    No Cover Available
                                </div>

                            <% } %>

                        </div>


                        <!-- Book Information -->
                        <div class="search-book-details">

                            <h2><%= book.title %></h2>

                            <p>
                                Author:
                                <%= book.author_name
                                    ? book.author_name.join(", ")
                                    : "Unknown" %>
                            </p>

                            <p>
                                First published:
                                <%= book.first_publish_year || "Unknown" %>
                            </p>


                            <!-- Add Book to Library Form -->
                            <form action="/books" method="POST">

                                <input
                                    type="hidden"
                                    name="title"
                                    value="<%= book.title %>"
                                >

                                <input
                                    type="hidden"
                                    name="author"
                                    value="<%= book.author_name
                                        ? book.author_name.join(', ')
                                        : '' %>"
                                >

                                <input
                                    type="hidden"
                                    name="isbn"
                                    value="<%= book.isbn && book.isbn.length > 0
                                        ? book.isbn[0]
                                        : '' %>"
                                >

                                <input
                                    type="hidden"
                                    name="cover_id"
                                    value="<%= book.cover_i || '' %>"
                                >

                                <button type="submit">
                                    + Add to My Library
                                </button>

                            </form>

                        </div>

                    </article>

                <% }); %>

            </div>


        <!-- No Results Found -->
        <% } else { %>

            <p class="empty-results">
                No books found. Try another search.
            </p>

        <% } %>

    </main>

</body>
</html>
